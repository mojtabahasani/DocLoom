{
  "name": "datasave",
  "version": "1.3.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "description": "DataSave — Offline-first Persian/RTL Markdown document studio, single-file HTML/PWA/DOCX/PDF compiler, and zero-dependency BIFF8/XLSX/FastReport engine",
  "homepage": "https://github.com/mojtabahasani/DataSave",
  "repository": {
    "type": "git",
    "url": "https://github.com/mojtabahasani/DataSave.git"
  },
  "keywords": [
    "markdown",
    "rtl",
    "persian",
    "document-studio",
    "single-file",
    "docx",
    "pdf",
    "biff8",
    "ole2",
    "fastreport",
    "pwa"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.mjs tests/server/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm test && npm run test:e2e",
    "server": "node server/index.js",
    "dev": "node build.mjs --watch",
    "verify:bank": "node tools/verify-bank.mjs",
    "guard": "node scripts/guardian/scan.mjs",
    "guard:ratchet": "node scripts/guardian/scan.mjs --ratchet",
    "guard:baseline": "node scripts/guardian/scan.mjs --update-baseline"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@darwin/guardian": "file:vendor/darwin/darwin-guardian-0.3.2.tgz",
    "@playwright/test": "^1.64.1",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.7",
    "linkedom": "^0.18.14",
    "vazirmatn": "^33.0.3"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "modern-screenshot": "^4.7.0",
    "qrcode-generator": "^2.0.4"
  }
}
